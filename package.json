{
  "name": "sidekick-p.a",
  "version": "1.0.0",
  "description": "an AI assistant to help students manage their day to day school life",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k -n TYPESCRIPT,VITE,ELECTRON -c blue,green,magenta \"tsc --watch --preserveWatchOutput\" \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:3000 dist/main/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:3000 electron .\"",
    "build": "tsc -p tsconfig.json && tsc -p src/renderer/tsconfig.json && vite build",
    "start": "electron ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickndeda/SIDEKICK-P.A.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/nickndeda/SIDEKICK-P.A/issues"
  },
  "homepage": "https://github.com/nickndeda/SIDEKICK-P.A#readme",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  }
}
